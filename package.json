{
	"name": "@wesleymfrederick/jact",
	"version": "1.0.0",
	"description": "Just Another Context Tool - Citation link validator and manager for markdown files",
	"type": "module",
	"main": "dist/jact-cli.js",
	"bin": {
		"jact": "./bin/jact.js"
	},
	"files": [
		"bin/",
		"dist/"
	],
	"scripts": {
		"clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
		"build": "npm run clean && tsc",
		"global:link": "bash scripts/refresh-global-cli.sh",
		"prepare": "npm run build",
		"prepublishOnly": "npm run type-check && npm test",
		"smoke:pack": "bash scripts/smoke-pack.sh",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"type-check": "tsc --noEmit",
		"check": "npm run type-check && npm test",
		"start": "node dist/cli.js",
		"jact:validate": "node ./dist/cli.js validate",
		"jact:ast": "node ./dist/cli.js ast",
		"jact:base-paths": "sh -c 'node ./dist/cli.js extract links \"$1\" --verbose 2>/dev/null | jq -r \".outgoingLinksReport.processedLinks[] | select(.sourceLink.target.path.absolute) | .sourceLink.target.path.absolute\" | sort -u' --",
		"jact:extract": "node ./dist/cli.js extract links",
		"jact:extract:content": "sh -c 'node ./dist/cli.js extract links \"$1\" | jq \".extractedContentBlocks\"' --",
		"jact:extract:header": "sh -c 'node ./dist/cli.js extract header \"$1\" \"$2\"' --",
		"jact:fix": "node ./dist/cli.js validate --fix",
		"sync-documentation-symlinks": "bun run ../0-documents/src/workflows/syncDocumentationSymlinks.ts $(pwd)/documentation-sync-manifest.json"
	},
	"keywords": [
		"citation",
		"validator",
		"markdown",
		"obsidian"
	],
	"author": "Wesley Frederick",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WesleyMFrederick/jact.git"
	},
	"homepage": "https://github.com/WesleyMFrederick/jact#readme",
	"bugs": {
		"url": "https://github.com/WesleyMFrederick/jact/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "npm@12.0.1",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"dependencies": {
		"commander": "^14.0.1",
		"ignore": "^7.0.5",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-frontmatter": "^2.0.1",
		"mdast-util-to-string": "^4.0.0",
		"micromark-core-commonmark": "^2.0.4",
		"micromark-extension-frontmatter": "^2.0.0",
		"micromark-util-character": "^2.1.1",
		"micromark-util-combine-extensions": "^2.0.1",
		"micromark-util-symbol": "^2.0.1",
		"tinyglobby": "^0.2.15",
		"unist-util-visit-parents": "6.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.4",
		"@typescript-eslint/parser": "^8.59.1",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/ui": "^5.0.3",
		"eslint": "^10.3.0",
		"typescript": "^5.9.3",
		"vitest": "^5.0.3"
	},
	"allowScripts": {
		"fsevents": false
	}
}
